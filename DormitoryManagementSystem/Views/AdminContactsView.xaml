<UserControl x:Class="DormitoryManagementSystem.Views.AdminContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormitoryManagementSystem.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <!-- Фон градієнт -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E6F4EA" Offset="0" />
                <!-- дуже світлий зелений -->
                <GradientStop Color="#C7E6C9" Offset="1" />
                <!-- світло-зелений -->
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Назад -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопка Назад -->
        <Button Grid.Row="0"
            Content="← Назад"
            Command="{Binding BackCommand}"
            Style="{StaticResource LogoutButtonStyle}"
            HorizontalAlignment="Left"
            Margin="0,0,0,10"/>

        <!-- Таблиця зі зверненнями -->
        <DataGrid Grid.Row="1"
              ItemsSource="{Binding Messages}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              RowHeight="50"
              GridLinesVisibility="None"
              AlternatingRowBackground="#f7f7f7"
              HeadersVisibility="Column"
              Margin="0,0,0,0">
            <DataGrid.Columns>
                <!-- Дата/Час -->
                <DataGridTextColumn Header="Дата" 
                            Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                            Width="120"/>

                <!-- Користувач або “Анонім” -->
                <DataGridTextColumn Header="Користувач" Width="200">
                    <DataGridTextColumn.Binding>
                        <Binding Path="User.FullName" TargetNullValue="Анонім"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <!-- Анонім: галочка, якщо UserId == null -->
                <DataGridCheckBoxColumn Header="Анонім" 
                                 Binding="{Binding UserId, Converter={StaticResource NullToBoolConverter}}"
                                 Width="60"/>
                <!-- Кімната користувача -->
                <DataGridTextColumn Header="Кімната" 
                                    Binding="{Binding RoomInfo}" 
                                    Width="100"/>

                <!-- Прочитано: галочка, якщо IsRead == true -->
                <DataGridCheckBoxColumn Header="Прочитано"
                                 Binding="{Binding IsRead}"
                                 Width="80"/>

                <!-- Текст повідомлення -->
                <DataGridTextColumn Header="Повідомлення" Binding="{Binding Content}" Width="*"/>

                <!-- Колонка з кнопками «Позначити як прочитане» та «Видалити» -->
                <DataGridTemplateColumn Header="Дії" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Якщо ще не прочитано, показуємо кнопку “Позначити як прочитане” -->
                                <Button Content="Прочитано"
                        Margin="5,0"
                        Padding="6,2"
                        Style="{StaticResource NavButtonStyle}"
                        Background="LightGreen"
                        Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}"
                        IsEnabled="{Binding IsRead, Converter={StaticResource InverseBoolConverter}}"/>
                                <!-- Кнопка Видалити -->
                                <Button Content="Видалити"
                        Margin="5,0"
                        Padding="6,2"
                        Style="{StaticResource LogoutButtonStyle}"
                        Background="LightCoral"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
