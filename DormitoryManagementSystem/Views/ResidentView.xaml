<UserControl x:Class="DormitoryManagementSystem.Views.ResidentView"  
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <!-- Фон градієнт -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E6F4EA" Offset="0" />
                <!-- дуже світлий зелений -->
                <GradientStop Color="#C7E6C9" Offset="1" />
                <!-- світло-зелений -->
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Привітання -->
        <TextBlock Grid.Row="1" Text="{Binding WelcomeText}" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   Margin="0 0 0 60"/>

        <!-- Повідомлення від адміністрації -->
        <Border Grid.Row="0"
        Background="#FFEBF7EB"
            BorderBrush="#FF4CAF50"
            BorderThickness="2"
        CornerRadius="8"
        Padding="12"
        Margin="0,0,0,10"
        SnapsToDevicePixels="True"
        Visibility="{Binding AdminMessageVisibility}">
            <Border.Effect>
                <DropShadowEffect Color="#88000000"
                    BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🛈"
                   FontSize="20"
                   Margin="0,0,8,0"/>

                <!-- Текст повідомлення -->
                <TextBlock Text="{Binding AdminMessageContent}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FF2E7D32"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
    </StackPanel>
        </Border>


        <!-- Головне меню кнопок -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 0 0 10" ItemHeight="40" ItemWidth="140">
            <Button Style="{StaticResource NavButtonStyle}" Content="Основна інформація" Command="{Binding OpenPersonalInfoCommand}" />
            <Button Style="{StaticResource NavButtonStyle}" Content="Моя кімната" Command="{Binding OpenMyRoomCommand}" />
            <Button Style="{StaticResource NavButtonStyle}" Content="Запис у душ" Command="{Binding OpenShowerReservationCommand}" />
            <Button Style="{StaticResource NavButtonStyle}" Content="Контакти" Command="{Binding OpenContactCommand}" />
            <Button Style="{StaticResource NavButtonStyle}" Content="Оплата" Command="{Binding OpenPaymentCommand}" />
        </WrapPanel>

        <!-- Кнопка Вийти -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,10">
            <Button Style="{StaticResource LogoutButtonStyle}" Content="Вийти" Command="{Binding LogoutCommand}" Width="140" Height="40" />
        </WrapPanel>

        <!-- Область контенту -->
        <ContentControl Grid.Row="3" Content="{Binding CurrentView}" Margin="0"/>
    </Grid>
</UserControl>
