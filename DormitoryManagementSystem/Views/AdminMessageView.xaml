<UserControl x:Class="DormitoryManagementSystem.Views.AdminMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DormitoryManagementSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <GradientStop Color="#C7E6C9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Назад -->
            <RowDefinition Height="Auto"/>
            <!-- Поточне оголошення -->
            <RowDefinition Height="Auto"/>
            <!-- Форма створення -->
        </Grid.RowDefinitions>

        <!-- Кнопка Назад -->
        <Button Grid.Row="0"
                Content="← Назад"
                Command="{Binding BackCommand}"
                Style="{StaticResource LogoutButtonStyle}"
                HorizontalAlignment="Left"
                Width="120"
                Margin="0,0,0,15"/>

        <!-- Поточне активне оголошення -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20"
                Visibility="{Binding CurrentMessageVisibility}">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок секції -->
                <TextBlock Grid.Row="0"
                           Text="📢 Поточне оголошення (показується резидентам)"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2E5939"
                           Margin="0,0,0,15"/>

                <!-- Заголовок оголошення -->
                <Border Grid.Row="1"
                        Background="#FFEBF7EB"
                        BorderBrush="#FF4CAF50"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding CurrentMessageTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF2E7D32"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Вміст оголошення -->
                <Border Grid.Row="2"
                        Background="#FFEBF7EB"
                        BorderBrush="#FF4CAF50"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,15">
                    <TextBlock Text="{Binding CurrentMessageContent}"
                               FontSize="16"
                               Foreground="#FF2E7D32"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Кнопка деактивації -->
                <Button Grid.Row="3"
                        Content="🗑️ Деактивувати оголошення"
                        Command="{Binding DeactivateCommand}"
                        Background="#FFD32F2F"
                        Foreground="White"
                        FontWeight="Bold"
                        Width="220"
                        Height="40"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFB71C1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Форма створення нового оголошення -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="30"
                MaxWidth="700"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="10"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="✍️ Створити нове оголошення"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E2E2E"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Заголовок -->
                <TextBlock Text="Заголовок *" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         BorderBrush="#A3C294"
                         BorderThickness="1"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <!-- Вміст -->
                <TextBlock Text="Текст оголошення *" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="120"
                         Padding="8"
                         BorderBrush="#A3C294"
                         BorderThickness="1"
                         FontSize="14"
                         Margin="0,0,0,25"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Content="📤 Опублікувати"
                            Command="{Binding PublishCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Width="150"
                            Margin="0,0,10,0"/>

                    <Button Content="🔄 Очистити форму"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource LogoutButtonStyle}"
                            Width="150"/>
                </StackPanel>

                <!-- Підказка -->
                <TextBlock Text="💡 Після публікації оголошення одразу з'явиться у всіх резидентів"
                           FontSize="12"
                           Foreground="#666"
                           FontStyle="Italic"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
