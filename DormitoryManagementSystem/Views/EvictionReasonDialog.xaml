<Window x:Class="DormitoryManagementSystem.Views.EvictionReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Причина виселення"
        Height="220"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="White" Padding="15" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Вкажіть причину виселення:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="ReasonTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Скасувати"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Підтвердити"
                        Width="90"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>