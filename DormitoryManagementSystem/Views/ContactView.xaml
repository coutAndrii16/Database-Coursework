<UserControl x:Class="DormitoryManagementSystem.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <GradientStop Color="#C7E6C9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <Border CornerRadius="12"
                Background="White"
                Padding="20"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="500">
            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="Зв’яжіться з нами"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2D5B39"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Чекбокс анонімності -->
                <CheckBox Content="Анонімно"
                          IsChecked="{Binding IsAnonymous}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,15"/>

                <!-- Поле введення повідомлення -->
                <TextBlock Text="Ваше повідомлення:"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="120"
                         Margin="0,5,0,20"
                         Background="#F8F8F8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Надіслати"
                            Command="{Binding SubmitCommand}"
                            Padding="10,5"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Назад"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LogoutButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
