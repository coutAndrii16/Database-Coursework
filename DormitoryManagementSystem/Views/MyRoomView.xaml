<UserControl x:Class="DormitoryManagementSystem.Views.MyRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="20">
           <!-- Фон градієнт -->
   <Grid.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#E6F4EA" Offset="0" />
           <!-- дуже світлий зелений -->
           <GradientStop Color="#C7E6C9" Offset="1" />
           <!-- світло-зелений -->
       </LinearGradientBrush>
   </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Моя кімната" FontSize="20" FontWeight="Bold" />

        <DataGrid Grid.Row="1"
              ItemsSource="{Binding RoomMates}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeRows="False"
              HeadersVisibility="Column"
              Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ"     Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Стать"   Binding="{Binding Gender}"   Width="50"/>
                <DataGridTextColumn Header="Курс"    Binding="{Binding Course}"   Width="Auto"/>
                <DataGridTextColumn Header="Факультет" Binding="{Binding Faculty}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}"    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2"
   Content="Назад"
   Command="{Binding BackCommand}"
   Style="{StaticResource LogoutButtonStyle}"
   HorizontalAlignment="Center"
   Margin="0,10,0,0"/>
    </Grid>
</UserControl>
