<UserControl x:Class="DormitoryManagementSystem.Views.ShowerReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormitoryManagementSystem.Converters"
             xmlns:vm="clr-namespace:DormitoryManagementSystem.ViewModels"
             x:Name="Root">

    <UserControl.Resources>
        <conv:SlotReservationColorMultiConverter x:Key="SlotReservationColorMultiConverter"/>
        <conv:SlotButtonTextMultiConverter x:Key="SlotButtonTextMultiConverter" />
        <conv:IsCurrentUserToCommandConverter x:Key="IsCurrentUserToCommandConverter" />
        <conv:SlotAvailableToReserveConverter x:Key="SlotAvailableToReserveConverter"/>

       
    </UserControl.Resources>
    <!-- Фон градієнт -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <GradientStop Color="#C7E6C9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="20" HorizontalAlignment="Center" MaxWidth="1920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
             Text="Розклад душових"
             FontSize="24"
             FontWeight="Bold"
             HorizontalAlignment="Center"
             Margin="0,0,0,20" />

        <!-- Групований список слотів за часом -->
        <ScrollViewer Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedSlots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <!-- Лейбл часу -->
                            <TextBlock Text="{Binding TimeLabel}"
                       Width="120"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

                            <!-- Кнопки слота -->
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SlotButtonStyle}"
                                                Command="{Binding DataContext.ReserveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Slot, Converter={StaticResource SlotAvailableToReserveConverter}}">

                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource SlotReservationColorMultiConverter}">
                                                    <Binding Path="Reservation.UserId"/>
                                                    <Binding Path="DataContext.CurrentUserId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Background>

                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SlotButtonTextMultiConverter}">
                                                        <Binding Path="Reservation"/>
                                                        <Binding Path="DataContext.CurrentUserId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Повідомлення статусу -->
        <TextBlock Grid.Row="2"
             Text="{Binding StatusMessage}"
             Foreground="DarkGreen"
             FontWeight="SemiBold"
             Margin="0,20,0,10"
             HorizontalAlignment="Center"/>

        <!-- Кнопка Назад -->
        <Button Grid.Row="3"
          Content="Назад"
          Command="{Binding BackCommand}"
          Style="{StaticResource LogoutButtonStyle}"
          HorizontalAlignment="Center"
          Margin="0,10,0,0"/>
    </Grid>

</UserControl>
