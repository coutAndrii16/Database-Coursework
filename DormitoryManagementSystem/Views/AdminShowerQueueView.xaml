<UserControl x:Class="DormitoryManagementSystem.Views.AdminShowerQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DormitoryManagementSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <GradientStop Color="#C7E6C9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Назад -->
            <RowDefinition Height="Auto"/>
            <!-- Фільтр дати та часу -->
            <RowDefinition Height="*"/>
            <!-- Таблиці черг -->
        </Grid.RowDefinitions>

        <!-- Кнопка Назад -->
        <Button Grid.Row="0"
                Content="← Назад"
                Command="{Binding BackCommand}"
                Style="{StaticResource LogoutButtonStyle}"
                HorizontalAlignment="Left"
                Width="120"
                Margin="0,0,0,15"/>

        <!-- Панель вибору дати та часового слоту -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Дата:" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                
                <DatePicker SelectedDate="{Binding SelectedDate}"
                            Width="150"
                            Margin="0,0,20,0"/>

                <TextBlock Text="Часовий слот:" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                
                <ComboBox ItemsSource="{Binding TimeSlots}"
                          SelectedItem="{Binding SelectedTimeSlot}"
                          DisplayMemberPath="TimeRange"
                          Width="180"
                          Margin="0,0,20,0"/>

                <Button Content="🔍 Показати"
                        Command="{Binding LoadQueuesCommand}"
                        Style="{StaticResource NavButtonStyle}"
                        Width="120"/>
            </StackPanel>
        </Border>

        <!-- Таблиці черг (Чоловіча та Жіноча) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- Проміжок -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Чоловіча черга -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#55000000"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="👨 Чоловіча черга"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2E5939"/>
                        <TextBlock Text="{Binding MaleQueueCount}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#4CAF50"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Таблиця -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MaleQueue}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              AlternatingRowBackground="#F0F8F0"
                              HeadersVisibility="Column"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" 
                                                Binding="{Binding QueueNumber}" 
                                                Width="50"/>
                            
                            <DataGridTextColumn Header="ПІБ" 
                                                Binding="{Binding UserName}" 
                                                Width="*"
                                                MinWidth="150"/>
                            
                            <DataGridTextColumn Header="Кімната" 
                                                Binding="{Binding RoomInfo}" 
                                                Width="100"/>
                            
                            <DataGridTextColumn Header="Час запису" 
                                                Binding="{Binding ReservationTime}" 
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Жіноча черга -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#55000000"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="👩 Жіноча черга"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2E5939"/>
                        <TextBlock Text="{Binding FemaleQueueCount}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#4CAF50"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Таблиця -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FemaleQueue}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              AlternatingRowBackground="#FFF0F5"
                              HeadersVisibility="Column"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" 
                                                Binding="{Binding QueueNumber}" 
                                                Width="50"/>
                            
                            <DataGridTextColumn Header="ПІБ" 
                                                Binding="{Binding UserName}" 
                                                Width="*"
                                                MinWidth="150"/>
                            
                            <DataGridTextColumn Header="Кімната" 
                                                Binding="{Binding RoomInfo}" 
                                                Width="100"/>
                            
                            <DataGridTextColumn Header="Час запису" 
                                                Binding="{Binding ReservationTime}" 
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
