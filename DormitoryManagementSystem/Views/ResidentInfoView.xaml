<UserControl x:Class="DormitoryManagementSystem.Views.ResidentInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <!-- дуже світлий зелений -->
            <GradientStop Color="#C7E6C9" Offset="1" />
            <!-- світло-зелений -->
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <Border CornerRadius="12"
                Background="White"
                Padding="30"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="600"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="10"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Особиста інформація"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2E2E2E"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="ПІБ: "
                               FontSize="18"
                               FontWeight="SemiBold"
                               Width="120"/>
                    <TextBlock Text="{Binding FullName}"
                               FontSize="18"
                               Foreground="#333"/>
                </StackPanel>

                <!-- Інформація про кімнату -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Кімната: "
                               FontSize="16"
                               FontWeight="SemiBold"
                               Width="120"/>
                    <TextBlock Text="{Binding RoomInfo}"
                               FontSize="16"
                               Foreground="#333"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Email: "
                               FontSize="16"
                               FontWeight="SemiBold"
                               Width="120"/>
                    <TextBlock Text="{Binding Email}"
                               FontSize="16"
                               Foreground="#333"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <TextBlock Text="Телефон: "
                               FontSize="16"
                               FontWeight="SemiBold"
                               Width="120"/>
                    <TextBlock Text="{Binding PhoneNumber}"
                               FontSize="16"
                               Foreground="#333"/>
                </StackPanel>

                <Button Content="Назад"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource LogoutButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="10,5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
