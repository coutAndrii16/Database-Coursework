<UserControl x:Class="DormitoryManagementSystem.Views.ResidentSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DormitoryManagementSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
      <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4EA" Offset="0" />
            <GradientStop Color="#C7E6C9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Назад -->
            <RowDefinition Height="Auto"/>
            <!-- Фільтри -->
            <RowDefinition Height="*"/>
            <!-- Таблиця результатів -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки дій -->
        </Grid.RowDefinitions>

        <!-- Кнопка Назад -->
        <Button Grid.Row="0"
                Content="← Назад"
                Command="{Binding BackCommand}"
                Style="{StaticResource LogoutButtonStyle}"
                HorizontalAlignment="Left"
                Width="120"
                Margin="0,0,0,15"/>

        <!-- Панель фільтрів -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Рядок 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="ПІБ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FullNameFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             BorderBrush="#A3C294"
                             BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="Кімната" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding RoomNameFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             BorderBrush="#A3C294"
                             BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                    <TextBlock Text="Поверх" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FloorFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             BorderBrush="#A3C294"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Рядок 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Факультет" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Faculties}"
                              SelectedItem="{Binding SelectedFaculty}"
                              DisplayMemberPath="Name"
                              Padding="6"
                              BorderBrush="#A3C294"
                              BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="Курс" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox SelectedItem="{Binding CourseFilter}"
                              Padding="6"
                              BorderBrush="#A3C294"
                              BorderThickness="1">
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,10">
                    <TextBlock Text="Група" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding GroupFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             BorderBrush="#A3C294"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" 
                            VerticalAlignment="Bottom" 
                            Margin="10,0,0,10">
                    <Button Content="🔍 Шукати"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Width="120"
                            Height="40"
                            Margin="0,0,0,10"/>
                    
                    <Button Content="Очистити"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource LogoutButtonStyle}"
                            Width="120"
                            Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблиця результатів -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#55000000"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0"
                           Text="{Binding ResultsTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SearchResults}"
                          SelectedItem="{Binding SelectedResident}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="None"
                          AlternatingRowBackground="#F7F7F7"
                          HeadersVisibility="Column"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ПІБ" 
                                            Binding="{Binding FullName}" 
                                            Width="*"
                                            MinWidth="150"/>
                        
                        <DataGridTextColumn Header="Email" 
                                            Binding="{Binding Email}" 
                                            Width="*"
                                            MinWidth="180"/>
                        <DataGridTextColumn Header="Факультет" 
                                            Binding="{Binding Faculty.Name}" 
                                            Width="*"
                                            MinWidth="200"/>
                        
                        <DataGridTextColumn Header="Курс" 
                                            Binding="{Binding Course}" 
                                            Width="60"/>
                        
                        <DataGridTextColumn Header="Група" 
                                            Binding="{Binding Group}" 
                                            Width="100"/>
                        
                        <DataGridTextColumn Header="Телефон" 
                                            Binding="{Binding PhoneNumber}" 
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Кнопки дій над обраним -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="📋 Деталі"
                    Command="{Binding ShowDetailsCommand}"
                    Style="{StaticResource NavButtonStyle}"
                    Width="120"
                    Margin="5"
                    IsEnabled="{Binding IsResidentSelected}"/>

            <Button Content="🚪 Виселити"
                    Command="{Binding EvictCommand}"
                    Background="#FFD32F2F"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="{Binding IsResidentSelected}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB71C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A0A0A0"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
                </Button.Effect>
            </Button>

            <Button Content="📊 Статистика"
                    Command="{Binding ShowStatisticsCommand}"
                    Style="{StaticResource NavButtonStyle}"
                    Width="120"
                    Margin="5"
                    IsEnabled="{Binding IsResidentSelected}"/>
        </StackPanel>
    </Grid>
</UserControl>
